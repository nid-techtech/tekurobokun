{
  "host": "127.0.0.1",
  "port": 8787,
  "publicUrl": "http://localhost:8787",
  "admin": {
    "port": 8788
  },
  "llm": {
    "baseUrl": "http://127.0.0.1:8080",
    "models": {
      "main": {
        "model": "qwen3-8b",
        "maxTokens": 256,
        "temperature": 0.7
      },
      "sub": {
        "model": "qwen3-4b",
        "maxTokens": 256,
        "temperature": 0.7
      }
    },
    "activeAlias": "main",
    "contextTurns": 4,
    "jsonSchema": true,
    "timeoutMs": 60000
  },
  "tts": {
    "baseUrl": "http://127.0.0.1:50021",
    "speaker": 1
  },
  "inputSources": {
    "consoles": ["tablet", "phone"],
    "active": "robot"
  },
  "pairing": {
    "codeTtlMs": 60000,
    "maxFailures": 5,
    "failureWindowMs": 60000,
    "lockMs": 300000
  },
  "stt": {
    "provider": "whisper",
    "timeoutMs": 10000,
    "whisper": {
      "url": "http://127.0.0.1:8081",
      "language": "ja",
      "hallucinations": [
        "ご視聴ありがとうございました",
        "ご視聴ありがとうございます",
        "最後までご視聴いただきありがとうございました",
        "チャンネル登録お願いします",
        "チャンネル登録よろしくお願いします"
      ],
      "logprobThreshold": -0.3
    },
    "bench": {
      "executable": "",
      "modelsDir": "",
      "extraArgs": [],
      "models": [
        { "name": "large-v3-turbo-q5_0", "file": "ggml-large-v3-turbo-q5_0.bin" },
        { "name": "large-v3-turbo-q8_0", "file": "ggml-large-v3-turbo-q8_0.bin" },
        { "name": "kotoba-whisper-v2.0-q5_0", "file": "ggml-kotoba-whisper-v2.0-q5_0.bin" }
      ],
      "vadModel": "ggml-silero-v6.2.0.bin"
    }
  },
  "search": {
    "provider": "tavily",
    "apiKey": "",
    "maxResults": 3,
    "timeoutMs": 8000
  },
  "dialogue": {
    "questionLoopThreshold": 2
  },
  "session": {
    "idleResetMs": 90000
  },
  "console": {
    "autosendMs": 3000,
    "fontSizePx": 18,
    "bottomInsetPx": 0,
    "prompt": {
      "user": "user",
      "host": "nid-techtech",
