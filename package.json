{
  "name": "tekurobokun",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run --filter @tekurobokun/i18n compile",
    "typecheck": "bun run --filter \"*\" typecheck",
    "check": "bun scripts/check.ts",
    "backend": "bun apps/backend/src/index.ts",
    "backend:stub": "bun apps/backend/src/index.ts --stub",
    "admin": "bun scripts/admin.ts",
    "console:dev": "bun run --filter @tekurobokun/console dev",
    "console:build": "bun run --filter @tekurobokun/console build",
    "console:icons": "bun scripts/gen_console_icons.ts",
    "robot:icons": "bun scripts/gen_robot_icons.ts",
    "bench": "bun scripts/bench_dialogue.ts",
    "stt:locations": "bun scripts/stt_locations.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tekurobokun/protocol": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "zxing-wasm": "^3.1.7"
  }
}
