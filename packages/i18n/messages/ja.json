{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app.name": "TEKUROBO-KUN",
  "status.ready": "待機中",
  "status.listening": "入力中",
  "status.thinking": "考え中",
  "status.speaking": "話し中",
  "status.offline": "つながっていません",
  "input.placeholder": "キーボードのマイクを押して、話しかけてください",
  "input.send_button": "送る",
  "input.clear_button": "消す",
  "input.autosend": "{seconds}秒後に送ります",
  "input.inactive_title": "いまは別の端末で受け付けています",
  "input.inactive_body": "この端末からは話しかけられません。スタッフが切り替えると使えるようになります。",
  "shell.user": "user",
  "shell.host": "nid-techtech",
  "shell.dir": "~/makers",
  "shell.prompt": "{user}@{host}:{dir} %",
  "shell.finished": "{name} finished thinking in {duration}",
  "shell.thinking": "{name} is thinking",
  "shell.output_mark": ">",
  "log.you": "あなた",
  "log.robot": "テクロボ",
  "log.empty": "まだ会話はありません。テクロボくんに話しかけてみましょう。",
  "log.thinking": "考えています",
  "error.offline_title": "テクロボくんにつながっていません",
  "error.offline_body": "スタッフに声をかけてください。つながると自動で元に戻ります。",
  "face.caption_line": "{who}> {text}",
  "debug.no_caption": "(なし)"
}
